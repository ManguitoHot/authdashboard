# Ruta del archivo SQLite. Tiene que estar DENTRO del volumen que montes en
# EasyPanel (pestaña "Almacenamiento" -> "Agregar montaje de volumen" sobre
# /app/data), si no, se pierde en cada redeploy. Si no la seteas, usa este
# mismo valor por default (ya viene en el Dockerfile).
DB_PATH=/app/data/telemetry.db

# Clave compartida que debe viajar en el header X-API-KEY desde el Wizard
# (y desde el propio dashboard) para poder registrar señales. Generá una
# larga y random, ej: openssl rand -hex 20
TELEMETRY_API_KEY=cambia_esto_por_una_clave_larga_y_random

PORT=3000
